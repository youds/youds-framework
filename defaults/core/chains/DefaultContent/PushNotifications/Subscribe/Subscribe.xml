<?xml version="1.0" encoding="UTF-8"?>
<ae:configurations
	xmlns="http://framework.youds.com/xml/config/parts/validators"
	xmlns:ae="http://framework.youds.com/xml/config/global/envelope"
	parent="%core.src_dir%/config/defaults/validators.xml"
>
	<ae:configuration>
		
		<validators>
			<validator class="Validator\Text" required="true">
				<arguments>
					<argument>authToken</argument>
					<argument>contentEncoding</argument>
					<argument>endpoint</argument>
					<argument>publicKey</argument>
				</arguments>
				<errors>
					<error>Not enough data received</error>
				</errors>
				<ae:parameters>
					<ae:parameter name="min">1</ae:parameter>
				</ae:parameters>
			</validator>
		
		</validators>
		
	</ae:configuration>
</ae:configurations>
