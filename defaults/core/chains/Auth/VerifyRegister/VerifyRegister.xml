<?xml version="1.0" encoding="UTF-8"?>
<ae:configurations
	xmlns="http://framework.youds.com/xml/config/parts/validators"
	xmlns:ae="http://framework.youds.com/xml/config/global/envelope"
	parent="%core.src_dir%/config/defaults/validators.xml"
>
	<ae:configuration>
		
		<validators>
			<validator class="Validator\Text" required="false">
				<arguments>
					<argument>code</argument>
				</arguments>
				<ae:parameters>
					<ae:parameter name="min">16</ae:parameter>
					<ae:parameter name="max">64</ae:parameter>
				</ae:parameters>
			</validator>
			
			<validator class="Validator\Text" required="false">
				<arguments>
					<argument>g-recaptcha-response</argument>
				</arguments>
				<ae:parameters>
					<ae:parameter name="min">1</ae:parameter>
				</ae:parameters>
			</validator>
		</validators>
	</ae:configuration>
</ae:configurations>
