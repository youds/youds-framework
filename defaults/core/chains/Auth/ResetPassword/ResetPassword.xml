<?xml version="1.0" encoding="UTF-8"?>
<ae:configurations
	xmlns="http://framework.youds.com/xml/config/parts/validators"
	xmlns:ae="http://framework.youds.com/xml/config/global/envelope"
	parent="%core.src_dir%/config/defaults/validators.xml"
>
	<ae:configuration>
		
		<validators>
			<validator class="Validator\Text" required="true">
				<arguments>
					<argument>code</argument>
				</arguments>
				<ae:parameters>
					<ae:parameter name="min">32</ae:parameter>
				</ae:parameters>
			</validator>

		</validators>
		
		<validators method="write">		
			<validator class="Validator\Text" required="true" provides="password_char">
				<arguments>
					<argument>password</argument>
				</arguments>
				<errors>
					<error>The password must be at least 8 characters long.</error>
				</errors>
				<ae:parameters>
					<ae:parameter name="min">8</ae:parameter>
				</ae:parameters>
			</validator>
			
			<validator required="true" depends="password_char" provides="password_confirmation">
				<arguments>
					<argument>password</argument>
				</arguments>
				<errors>
					<error>The password must contain an uppercase, numeric and symbol character.</error>
				</errors>
				<ae:parameters>
					<ae:parameter name="min">8</ae:parameter>
				</ae:parameters>
			</validator>
		
		
			<validator required="true" depends="password_confirmation">
				<arguments>
					<argument>confirmPassword</argument>
				</arguments>
				<errors>
					<error>The password must match confirm password.</error>
				</errors>
				<ae:parameters>
					<ae:parameter name="value">password</ae:parameter>
					<ae:parameter name="asparam">true</ae:parameter>
				</ae:parameters>
			</validator>
			
		</validators>
	</ae:configuration>
</ae:configurations>
